---
interface Props {
  type: 'crypto' | 'transfer' | 'gold';
}

const { type } = Astro.props;

const affiliateLinks = {
  crypto: [
    {
      name: 'Binance TR',
      url: 'https://www.binancetr.com/register?ref=dolareuroaltin',
      description: 'Türkiye\'nin en büyük kripto borsası',
      badge: 'Popüler',
    },
    {
      name: 'Paribu',
      url: 'https://www.paribu.com/?ref=dolareuroaltin',
      description: '2017\'den beri güvenilir kripto alım satım',
      badge: '',
    },
    {
      name: 'BtcTurk',
      url: 'https://www.btcturk.com/?ref=dolareuroaltin',
      description: 'Türkiye\'nin ilk kripto borsası',
      badge: '',
    },
  ],
  transfer: [
    {
      name: 'Wise',
      url: 'https://wise.com/invite/dolareuroaltin',
      description: 'Uluslararası para transferinde gerçek döviz kuru, gizli ücret yok',
      badge: 'Önerilen',
    },
  ],
  gold: [
    {
      name: 'altin.com',
      url: 'https://www.altin.com/?ref=dolareuroaltin',
      description: 'Güvenilir online altın alışverişi',
      badge: '',
    },
  ],
};

const items = affiliateLinks[type];

const typeTitles: Record<string, string> = {
  crypto: 'Kripto Para Borsaları',
  transfer: 'Uluslararası Para Transferi',
  gold: 'Online Altın Alışverişi',
};

const typeIcons: Record<string, string> = {
  crypto: '₿',
  transfer: '💸',
  gold: '🥇',
};
---

<div class="affiliate-banner my-6" aria-label="Sponsorlu içerik">
  <div class="bg-gradient-to-r from-gray-50 to-slate-50 rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-2.5 bg-gray-100 border-b border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-base">{typeIcons[type]}</span>
        <span class="text-sm font-semibold text-gray-700">{typeTitles[type]}</span>
      </div>
      <span class="text-xs text-gray-400 bg-gray-200 px-2 py-0.5 rounded">sponsorlu</span>
    </div>

    <div class="p-4">
      {items.length === 1 ? (
        <a
          href={items[0].url}
          target="_blank"
          rel="nofollow noopener sponsored"
          class="flex items-center justify-between p-4 rounded-lg bg-white border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all group"
        >
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-gray-900 group-hover:text-blue-700 transition-colors">{items[0].name}</span>
              {items[0].badge && (
                <span class="px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">{items[0].badge}</span>
              )}
            </div>
            <p class="text-sm text-gray-500">{items[0].description}</p>
          </div>
          <svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 transition-colors flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {items.map(item => (
            <a
              href={item.url}
              target="_blank"
              rel="nofollow noopener sponsored"
              class="p-4 rounded-lg bg-white border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all group"
            >
              <div class="flex items-center gap-2 mb-1.5">
                <span class="font-bold text-gray-900 group-hover:text-blue-700 transition-colors text-sm">{item.name}</span>
                {item.badge && (
                  <span class="px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">{item.badge}</span>
                )}
              </div>
              <p class="text-xs text-gray-500 leading-relaxed">{item.description}</p>
              <div class="mt-2 text-xs text-blue-600 font-medium group-hover:text-blue-700 transition-colors">
                İncele →
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
