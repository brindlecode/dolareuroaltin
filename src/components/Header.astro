---
import rates from '../data/rates_current.json';
import { formatDateShort } from '../utils/rateHelpers';

const lastUpdated = rates.last_updated_display;
const lastUpdatedISO = rates.last_updated;
---

<header id="site-header" class="sticky top-0 z-50 bg-white transition-shadow duration-200">
  <div class="border-b border-gray-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">

        <a href="/" class="flex items-center gap-2 text-xl font-bold text-gray-900 hover:text-blue-700 transition-colors">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-white text-lg font-bold">₺</span>
          <span class="hidden sm:inline">dolareuroaltin</span>
          <span class="sm:hidden">dea</span>
        </a>

        <nav class="hidden lg:flex items-center gap-1">
          <a href="/dolar-kuru" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Dolar Kuru</a>
          <a href="/euro-kuru" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Euro Kuru</a>
          <a href="/altin-fiyati" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Altın Fiyatı</a>
          <a href="/doviz-cevirici" class="px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Döviz Çevirici</a>

          <div class="relative group">
            <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">
              Hesaplayıcılar
              <svg class="h-4 w-4 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 mt-1 w-52 rounded-xl bg-white shadow-lg ring-1 ring-black/5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="py-1">
                <a href="/gecmisteAlsaydim" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-700 transition-colors">Geçmişte Alsaydım</a>
                <a href="/enflasyon" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-700 transition-colors">Enflasyon</a>
              </div>
            </div>
          </div>
        </nav>

        <div class="flex items-center gap-3">
          <div class="hidden md:flex items-center gap-2 text-xs text-gray-500">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <time datetime={lastUpdatedISO}>{lastUpdated}</time>
          </div>

          <label for="mobile-menu-toggle" class="lg:hidden flex items-center justify-center h-10 w-10 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
            <svg class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
        </div>
      </div>
    </div>
  </div>

  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />

  <div class="lg:hidden hidden peer-checked:block border-t border-gray-100 bg-white">
    <nav class="mx-auto max-w-7xl px-4 py-3 space-y-1">
      <a href="/dolar-kuru" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Dolar Kuru</a>
      <a href="/euro-kuru" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Euro Kuru</a>
      <a href="/altin-fiyati" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Altın Fiyatı</a>
      <a href="/doviz-cevirici" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Döviz Çevirici</a>
      <div class="border-t border-gray-50 pt-2 mt-2">
        <p class="px-3 pb-1.5 text-xs font-semibold uppercase tracking-wider text-gray-400">Hesaplayıcılar</p>
        <a href="/gecmisteAlsaydim" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Geçmişte Alsaydım</a>
        <a href="/enflasyon" class="block px-3 py-2.5 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-700 transition-colors">Enflasyon</a>
      </div>
      <div class="flex items-center gap-2 px-3 pt-3 text-xs text-gray-500 md:hidden">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <time datetime={lastUpdatedISO}>{lastUpdated}</time>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  let ticking = false;

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        if (window.scrollY > 4) {
          header.classList.add('shadow-md');
        } else {
          header.classList.remove('shadow-md');
        }
        ticking = false;
      });
      ticking = true;
    }
  });
</script>
