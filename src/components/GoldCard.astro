---
import { getChangeClass, getChangeIcon, formatTRY, formatRate } from '../utils/rateHelpers';

interface Props {
  key: string;
  name_tr: string;
  buying: number;
  selling: number;
  mid: number;
  change_daily: number;
  change_pct: number;
  direction: 'up' | 'down' | 'neutral';
  unit?: string;
  size?: 'large' | 'medium' | 'small';
}

const {
  key: goldKey,
  name_tr,
  buying,
  selling,
  mid,
  change_daily,
  change_pct,
  direction,
  unit,
  size = 'medium',
} = Astro.props;

const changeClass = getChangeClass(direction);
const changeIcon = getChangeIcon(direction);

const formattedMid = formatTRY(mid);
const formattedBuying = formatRate(buying);
const formattedSelling = formatRate(selling);
const formattedChange = formatTRY(Math.abs(change_daily));
const formattedChangePct = Math.abs(change_pct).toFixed(2).replace('.', ',');

const changePrefix = direction === 'up' ? '+' : direction === 'down' ? '-' : '';

const goldIcon = ['xau_usd'].includes(goldKey) ? '🪙' : '🥇';

const displayUnit = unit || '';

const ariaLabel = `${name_tr} fiyatı ${formattedMid} Türk Lirası${displayUnit ? ' ' + displayUnit : ''}, ${direction === 'up' ? 'artış' : direction === 'down' ? 'düşüş' : 'değişim yok'}`;
---

{size === 'small' && (
  <tr
    class="border-b border-gray-100 hover:bg-gray-50 transition-colors"
    aria-label={ariaLabel}
  >
    <td class="py-2.5 px-3">
      <div class="flex items-center gap-2">
        <span class="text-lg">{goldIcon}</span>
        <div>
          <span class="font-semibold text-sm text-gray-900">{name_tr}</span>
          {displayUnit && <span class="text-xs text-gray-500 ml-1.5">{displayUnit}</span>}
        </div>
      </div>
    </td>
    <td class="py-2.5 px-3 text-right">
      <span class="font-mono text-sm font-medium text-gray-900">{formattedBuying}</span>
    </td>
    <td class="py-2.5 px-3 text-right">
      <span class="font-mono text-sm font-medium text-gray-900">{formattedSelling}</span>
    </td>
    <td class="py-2.5 px-3 text-right">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium {changeClass}">
        {changeIcon} {changePrefix}{formattedChangePct}%
      </span>
    </td>
  </tr>
)}

{size === 'medium' && (
  <div
    class="bg-white rounded-xl shadow-sm border border-amber-100 p-4 hover:shadow-md hover:border-amber-200 transition-all duration-200 cursor-pointer"
    aria-label={ariaLabel}
  >
    <div class="flex items-start justify-between mb-3">
      <div class="flex items-center gap-2.5">
        <span class="text-2xl">{goldIcon}</span>
        <div>
          <div class="font-bold text-gray-900">{name_tr}</div>
          {displayUnit && <div class="text-xs text-gray-500">{displayUnit}</div>}
        </div>
      </div>
    </div>

    <div class="mb-3">
      <div class="flex items-baseline gap-1">
        <span class="text-xs text-gray-400">₺</span>
        <span class="text-2xl font-bold font-mono text-gray-900">{formattedMid}</span>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-1.5">
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-semibold {changeClass}">
          {changeIcon} {changePrefix}{formattedChangePct}%
        </span>
      </div>
      <div class="text-xs text-gray-400">
        <span class="text-gray-500">Alış:</span> {formattedBuying}
        <span class="mx-1">·</span>
        <span class="text-gray-500">Satış:</span> {formattedSelling}
      </div>
    </div>
  </div>
)}

{size === 'large' && (
  <div
    class="bg-white rounded-2xl shadow-sm border border-amber-100 overflow-hidden"
    aria-label={ariaLabel}
  >
    <div class="p-6">
      <div class="flex items-start justify-between mb-6">
        <div class="flex items-center gap-4">
          <span class="text-4xl">{goldIcon}</span>
          <div>
            <h2 class="text-xl font-bold text-gray-900">{name_tr}</h2>
            {displayUnit && (
              <span class="inline-block mt-1 px-2.5 py-0.5 bg-amber-50 text-amber-700 text-sm font-mono rounded-md">{displayUnit}</span>
            )}
          </div>
        </div>
        <div class="text-right">
          <div class="text-3xl font-bold font-mono text-gray-900">₺{formattedMid}</div>
          <div class="inline-flex items-center gap-1.5 mt-1.5 px-3 py-1 rounded-lg text-sm font-semibold {changeClass}">
            {changeIcon}
            <span>{changePrefix}{formattedChange} ({changePrefix}{formattedChangePct}%)</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-amber-50 rounded-xl p-4">
          <div class="text-xs text-amber-600 font-medium mb-1">Alış</div>
          <div class="text-lg font-mono font-semibold text-amber-900">₺{formattedBuying}</div>
        </div>
        <div class="bg-amber-50 rounded-xl p-4">
          <div class="text-xs text-amber-600 font-medium mb-1">Satış</div>
          <div class="text-lg font-mono font-semibold text-amber-900">₺{formattedSelling}</div>
        </div>
      </div>

      <div class="border-t border-gray-100 pt-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Gün İçi</h3>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <div class="text-xs text-gray-400 mb-1">Alış-Satış Farkı</div>
            <div class="font-mono text-sm font-medium text-gray-900">{formatTRY(selling - buying)}</div>
          </div>
          <div>
            <div class="text-xs text-gray-400 mb-1">Spread %</div>
            <div class="font-mono text-sm font-medium text-gray-900">{((selling - buying) / mid * 100).toFixed(2).replace('.', ',')}%</div>
          </div>
          <div>
            <div class="text-xs text-gray-400 mb-1">Günlük Değişim</div>
            <div class="font-mono text-sm font-medium {direction === 'up' ? 'text-emerald-600' : direction === 'down' ? 'text-red-600' : 'text-gray-500'}">
              {changePrefix}{formattedChange}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
)}
