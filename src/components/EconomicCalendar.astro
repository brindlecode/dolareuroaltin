---
import calendarData from '../data/economic_calendar.json';

interface CalendarEvent {
  date: string;
  time: string;
  title_tr: string;
  type: string;
  importance: 'high' | 'medium' | 'low';
  description_tr?: string;
  current_rate?: number;
  forecast_tr?: string;
}

const events: CalendarEvent[] = calendarData.events;

const importanceConfig = {
  high: { label: 'Yüksek', bg: 'bg-red-100', text: 'text-red-700', border: 'border-l-red-500', dot: 'bg-red-500' },
  medium: { label: 'Orta', bg: 'bg-yellow-100', text: 'text-yellow-700', border: 'border-l-yellow-500', dot: 'bg-yellow-500' },
  low: { label: 'Düşük', bg: 'bg-green-100', text: 'text-green-700', border: 'border-l-green-500', dot: 'bg-green-500' },
};

const typeLabels: Record<string, string> = {
  tcmb: 'TCMB',
  tuik: 'TÜİK',
  hazine: 'Hazine',
};

const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  const months = ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'];
  const days = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}, ${days[date.getDay()]}`;
};
---

<div class="economic-calendar bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden" aria-label="Ekonomik takvim">
  <div class="p-5 pb-0">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
        <span class="text-xl">📆</span>
        Ekonomik Takvim
      </h2>
      <span class="text-xs text-gray-400">{events.length} etkinlik</span>
    </div>

    <div class="flex items-center gap-2 mb-4" role="group" aria-label="Takvim filtresi">
      <button
        class="filter-btn active px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200 transition-colors"
        data-filter="all"
      >
        Tümü
      </button>
      <button
        class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
        data-filter="tcmb"
      >
        TCMB
      </button>
      <button
        class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
        data-filter="tuik"
      >
        TÜİK
      </button>
    </div>

    <div class="flex items-center gap-3 mb-4 text-xs text-gray-400">
      <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500"></span> Yüksek</span>
      <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-500"></span> Orta</span>
      <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-500"></span> Düşük</span>
    </div>
  </div>

  <div id="calendar-events" class="divide-y divide-gray-50">
    {events.map((event) => {
      const config = importanceConfig[event.importance];
      return (
        <div
          class="event-item calendar-event border-l-4 {config.border} px-5 py-4 hover:bg-gray-50 transition-colors"
          data-type={event.type}
          data-importance={event.importance}
        >
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="text-xs font-medium text-gray-400">{formatDate(event.date)}</span>
                <span class="text-xs text-gray-300">•</span>
                <span class="text-xs font-mono text-gray-500">{event.time}</span>
                <span class="px-2 py-0.5 rounded text-xs font-semibold {config.bg} {config.text}">
                  {config.label}
                </span>
                <span class="px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">
                  {typeLabels[event.type] || event.type}
                </span>
              </div>
              <h3 class="text-sm font-semibold text-gray-900">{event.title_tr}</h3>
              {event.forecast_tr && (
                <p class="text-xs text-gray-500 mt-1">
                  Beklenti: {event.forecast_tr}
                  {event.current_rate && (
                    <span class="ml-1 text-gray-400">• Mevcut: %{event.current_rate}</span>
                  )}
                </p>
              )}
            </div>
            <div class="flex-shrink-0">
              <span class="w-2.5 h-2.5 rounded-full {config.dot} mt-1"></span>
            </div>
          </div>
          {event.description_tr && (
            <p class="text-xs text-gray-500 mt-2 leading-relaxed">{event.description_tr}</p>
          )}
        </div>
      );
    })}
  </div>
</div>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const eventItems = document.querySelectorAll('.event-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-blue-100', 'text-blue-700');
        b.classList.add('bg-gray-100', 'text-gray-600');
      });
      btn.classList.add('active', 'bg-blue-100', 'text-blue-700');
      btn.classList.remove('bg-gray-100', 'text-gray-600');

      const filter = (btn as HTMLElement).dataset.filter;

      eventItems.forEach(item => {
        const el = item as HTMLElement;
        if (filter === 'all' || el.dataset.type === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
