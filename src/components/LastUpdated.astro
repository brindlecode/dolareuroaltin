---
import ratesCurrent from '../data/rates_current.json';

const lastUpdated = ratesCurrent.last_updated_display;
const source = ratesCurrent.source;
---

<div class="last-updated inline-flex items-center gap-2 text-xs text-gray-400" aria-label={`Son güncelleme: ${lastUpdated}`}>
  <span class="pulse-dot"></span>
  <span>Son güncelleme: {lastUpdated} • {source} verisi</span>
</div>

<style>
  .last-updated {
    user-select: none;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    }
    50% {
      opacity: 0.6;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0);
    }
  }
</style>
