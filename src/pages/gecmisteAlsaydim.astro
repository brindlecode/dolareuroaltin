---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RateTicker from '../components/RateTicker.astro';
import AdSenseSlot from '../components/AdSenseSlot.astro';
import HistoryCalculator from '../components/HistoryCalculator.astro';
import usdHistorical from '../data/rates_historical_usd.json';
import eurHistorical from '../data/rates_historical_eur.json';
import goldHistorical from '../data/rates_historical_gold.json';
import inflationData from '../data/inflation_data.json';
import ratesCurrent from '../data/rates_current.json';
import { formatTRY, formatDateFull } from '../utils/rateHelpers';

const formattedDate = formatDateFull(ratesCurrent.last_updated);

const currentUsdRate = usdHistorical.data[usdHistorical.data.length - 1].close;
const currentEurRate = eurHistorical.data[eurHistorical.data.length - 1].close;
const currentGoldRate = goldHistorical.data[goldHistorical.data.length - 1].close;

const getHistoricalRate = (data: any[], year: number): number => {
  const yearEntries = data.filter(d => d.date.startsWith(String(year)));
  if (yearEntries.length === 0) return 0;
  return yearEntries[0].close;
};

const calculateFutureValue = (initialTRY: number, historicalRate: number, currentRate: number): number => {
  const amountBought = initialTRY / historicalRate;
  return amountBought * currentRate;
};

const examples = [
  {
    year: 2020,
    label: "2020'de 10.000 TL dolar alsaydın",
    initial: 10000,
    historicalRate: getHistoricalRate(usdHistorical.data, 2020),
    currentRate: currentUsdRate,
    currency: 'USD',
    flag: '🇺🇸',
  },
  {
    year: 2021,
    label: "2021'de 10.000 TL altın alsaydın",
    initial: 10000,
    historicalRate: getHistoricalRate(goldHistorical.data, 2021),
    currentRate: currentGoldRate,
    currency: 'Gram Altın',
    flag: '🥇',
  },
  {
    year: 2022,
    label: "2022'de 10.000 TL euro alsaydın",
    initial: 10000,
    historicalRate: getHistoricalRate(eurHistorical.data, 2022),
    currentRate: currentEurRate,
    currency: 'EUR',
    flag: '🇪🇺',
  },
  {
    year: 2023,
    label: "2023'te 10.000 TL dolar alsaydın",
    initial: 10000,
    historicalRate: getHistoricalRate(usdHistorical.data, 2023),
    currentRate: currentUsdRate,
    currency: 'USD',
    flag: '🇺🇸',
  },
];

const shareUrl = 'https://dolareuroaltin.com/gecmisteAlsaydim';
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent('Geçmişte alsaydım ne kadar kazanırdım? Hesapla:')}&url=${encodeURIComponent(shareUrl)}`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent('Geçmişte alsaydım ne kadar kazanırdım? Hesapla:')}%20${encodeURIComponent(shareUrl)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;

const faqData = [
  {
    question: 'Geçmişte alsaydım hesaplayıcı ne işe yarar?',
    answer: 'Bu araç, geçmiş bir tarihte Dolar, Euro veya Altın alsaydınız bugünkü değerinin ne olacağını hesaplar. Enflasyon karşılaştırması ile reel getirinizi de gösterir.',
  },
  {
    question: 'Hangi para birimlerini hesaplayabilirim?',
    answer: 'USD (Amerikan Doları), EUR (Euro), Gram Altın ve Bitcoin için hesaplama yapabilirsiniz. 2020-2025 yılları arasındaki veriler mevcuttur.',
  },
  {
    question: 'Hesaplamalar ne kadar doğru?',
    answer: 'Hesaplamalar TCMB resmi kurları ve TÜİK enflasyon verilerine dayanır. Gerçek yatırım sonuçları; komisyon, makas farkı ve vergiler nedeniyle farklı olabilir.',
  },
  {
    question: 'Enflasyonla karşılaştırma nasıl yapılır?',
    answer: 'TÜİK verileri kullanılarak, yatırım yaptığınız yıldan bugüne kadar olan kümülatif enflasyon hesaplanır. Bu sayede nominal getiriniz ile reel getiriniz karşılaştırılır.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Geçmişte Alsaydım Hesaplayıcı',
  url: 'https://dolareuroaltin.com/gecmisteAlsaydim',
  description: 'Geçmişte Dolar, Euro veya Altın alsaydınız ne kadar kazanırdınız? Hesaplayın.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'TRY',
  },
};
---

<BaseLayout
  title="Geçmişte Dolar/Euro/Altın Alsaydım Ne Olurdu?"
  description="Geçmişte Dolar, Euro veya Altın alsaydınız bugünkü değeri ne olurdu? Enflasyon karşılaştırmalı geçmişte alsaydım hesaplayıcı."
  canonical="https://dolareuroaltin.com/gecmisteAlsaydim"
>
  <Header slot="header" />

  <RateTicker />

  <section class="mb-8 mt-6" aria-label="Giriş">
    <div class="text-center">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-3">
        Geçmişte Dolar/Euro/Altın Alsaydım Ne Olurdu?
      </h1>
      <p class="text-sm text-gray-500 mb-1">{formattedDate}</p>
      <p class="text-xs text-gray-400">TCMB resmi kurları • TÜİK enflasyon verileri</p>
    </div>
  </section>

  <AdSenseSlot size="leaderboard" />

  <section class="mb-8" aria-label="Geçmişte alsaydım hesaplayıcı">
    <HistoryCalculator />
  </section>

  <section class="mb-8" aria-label="Örnek hesaplamalar">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-lg font-bold text-gray-900">Örnek Hesaplamalar</h2>
        <p class="text-xs text-gray-400 mt-0.5">10.000 TL yatırım ile örnek senaryolar</p>
      </div>
      <div class="divide-y divide-gray-50">
        {examples.map((ex) => {
          const futureValue = calculateFutureValue(ex.initial, ex.historicalRate, ex.currentRate);
          const profit = futureValue - ex.initial;
          const profitPct = ((futureValue - ex.initial) / ex.initial) * 100;
          const isProfit = profit >= 0;

          return (
            <div class="px-5 py-4 hover:bg-gray-50 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-700">{ex.flag} {ex.label}</span>
                <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold ${isProfit ? 'text-emerald-600 bg-emerald-50' : 'text-red-600 bg-red-50'}`}>
                  {isProfit ? '▲' : '▼'} %{formatTRY(Math.abs(profitPct))}
                </span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="text-gray-500">₺{formatTRY(ex.initial)}</span>
                <span class="text-gray-300">→</span>
                <span class="font-bold font-mono text-gray-900">₺{formatTRY(futureValue)}</span>
                <span class={`text-xs font-mono ${isProfit ? 'text-emerald-600' : 'text-red-600'}`}>
                  ({isProfit ? '+' : ''}₺{formatTRY(Math.abs(profit))})
                </span>
              </div>
              <div class="text-xs text-gray-400 mt-1">
                {ex.year} kuru: ₺{formatTRY(ex.historicalRate)} → Bugün: ₺{formatTRY(ex.currentRate)}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <AdSenseSlot size="rectangle" />

  <section class="mb-8" aria-label="Geçmişte alsaydım nedir">
    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Geçmişte Alsaydım Hesaplayıcı Nedir?</h2>
      <div class="prose prose-gray max-w-none">
        <p class="text-gray-600 leading-relaxed mb-4">
          "Geçmişte alsaydım" hesaplayıcısı, belirli bir tarihte Dolar, Euro, Altın veya Bitcoin'e yatırım yapsaydınız
          bugünkü değerinin ne olacağını gösteren bir finansal hesaplama aracıdır. Bu araç sayesinde geçmiş yatırım
          kararlarının potansiyel sonuçlarını görselleştirebilir ve farklı varlık sınıflarının performansını
          karşılaştırabilirsiniz.
        </p>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Nasıl Çalışır?</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
          Hesaplayıcı, TCMB'nin geçmişe dönük resmi döviz kurlarını ve altın fiyatlarını kullanır. Seçtiğiniz yıldaki
          kur ile yatırım tutarınızın kaç birim döviz veya altın alabileceğini hesaplar. Ardından bu miktarı bugünkü
          kur ile çarparak bugünkü değerini bulur. Son olarak TÜİK enflasyon verileri ile reel getirinizi karşılaştırır.
        </p>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Neden Önemli?</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
          Türkiye'de yüksek enflasyon ortamında paranın satın alma gücü hızla azalır. Döviz ve altın gibi varlıklar,
          enflasyona karşı korunma aracı olarak görülür. Geçmişte alsaydım hesaplayıcısı, farklı varlık sınıflarının
          enflasyona karşı ne kadar koruma sağladığını somut rakamlarla gösterir. Bu sayede yatırım kararlarınızı
          daha bilinçli bir şekilde verebilirsiniz.
        </p>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Nominal Getiri vs. Reel Getiri</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
          <strong className="text-gray-900">Nominal getiri:</strong> Yatırımınızın sayısal olarak ne kadar arttığını gösterir.
          Örneğin 2020'de 10.000 TL ile dolar alsaydınız, bugün 52.027 TL değerinde olurdu — bu nominal getiridir.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          <strong className="text-gray-900">Reel getiri:</strong> Enflasyon etkisi arındırıldıktan sonra kalan gerçek kazançtır.
          Aynı dönemde enflasyon %200 arttıysa, reel getiriniz nominal getiriden daha düşük olacaktır. Hesaplayıcımız
          her iki metriği de göstererek yatırımınızın gerçek performansını anlamanızı sağlar.
        </p>
      </div>
    </article>
  </section>

  <section class="mb-8" aria-label="Paylaş">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Sonuçları Paylaş</h2>
      <p class="text-sm text-gray-600 mb-4">Hesaplama sonuçlarınızı arkadaşlarınızla paylaşın:</p>
      <div class="flex items-center gap-3">
        <a
          href={twitterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-50 text-sky-600 text-sm font-medium hover:bg-sky-100 transition-colors"
          aria-label="Twitter'da paylaş"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Twitter
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-green-50 text-green-600 text-sm font-medium hover:bg-green-100 transition-colors"
          aria-label="WhatsApp'ta paylaş"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-50 text-blue-600 text-sm font-medium hover:bg-blue-100 transition-colors"
          aria-label="Facebook'ta paylaş"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
      </div>
    </div>
  </section>

  <section class="mb-8" aria-label="SSS">
    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Sıkça Sorulan Sorular</h2>
      <div class="space-y-4">
        {faqData.map((faq) => (
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">{faq.question}</h3>
            <p class="text-sm text-gray-600">{faq.answer}</p>
          </div>
        ))}
      </div>
    </article>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(appLd)} />

  <Footer slot="footer" />
</BaseLayout>
